# superfile-enhanced — safe configuration placeholders.
# NEVER put real credentials in this file or commit them.
# Copy to config.local.toml (gitignored) and fill in real values there.

# ── S3 (AWS S3, MinIO, DigitalOcean Spaces, Wasabi) ──────────────
S3_BUCKET=my-bucket
S3_REGION=us-east-1
S3_ENDPOINT=                       # optional, e.g. https://minio.example.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
# ── Azure Blob Storage ───────────────────────────────────────────
AZURE_ACCOUNT_NAME=mystorageaccount
AZURE_ACCOUNT_KEY=                 # base64 account key (leave empty to use managed identity)
AZURE_CONTAINER_NAME=files
AZURE_PREFIX=files/
AZURE_USE_MANAGED_ID=false         # true to authenticate with a managed identity

# ── Google Cloud Storage ─────────────────────────────────────────
GCS_BUCKET=my-bucket
GCS_PREFIX=files/
GOOGLE_APPLICATION_CREDENTIALS=    # path to a service-account JSON (never commit it)

# ── WebDAV (Nextcloud, OwnCloud, etc.) ───────────────────────────
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/me
WEBDAV_USERNAME=user
WEBDAV_PASSWORD=                   # app password recommended over account password
WEBDAV_INSECURE=false              # NEVER set true for public endpoints
